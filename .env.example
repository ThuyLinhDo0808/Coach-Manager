# Supabase (project riêng của Coach Trung Muối). Chỉ cần URL và khoá công khai,
# mọi quyền đọc/ghi do RLS trong supabase/migrations quyết định.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

